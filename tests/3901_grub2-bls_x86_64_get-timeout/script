export TEST_ARCH=x86_64
run pbl --loader grub2-bls

# no timeout set, and grub then waits forever
run pbl --get-timeout

mkdir -p /boot/efi/EFI/opensuse
echo "# GRUB Environment Block" > /boot/efi/EFI/opensuse/grubenv
run pbl --get-timeout

echo "timeout=3" >> /boot/efi/EFI/opensuse/grubenv
run pbl --get-timeout

# a menu that is not shown, and one that waits forever
sed -i -e "s/^timeout=.*/timeout=menu-hidden/" /boot/efi/EFI/opensuse/grubenv
run pbl --get-timeout

sed -i -e "s/^timeout=.*/timeout=menu-force/" /boot/efi/EFI/opensuse/grubenv
run pbl --get-timeout

# loader.conf is never read here
mkdir -p /boot/efi/loader
echo "timeout 9" > /boot/efi/loader/loader.conf
sed -i -e "/^timeout=/d" /boot/efi/EFI/opensuse/grubenv
run pbl --get-timeout
