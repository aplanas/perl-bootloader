[✔] pbl --loader grub2
[✔] pbl --add-option foo="bar  zap"
[✔] pbl --add-option quiet=99
[✔] pbl --add-option mitigations=0
[✔] pbl --add-option foobar1=
[✔] pbl --add-option foobar2
[✔] pbl --add-option cio_ignore=all,!0800-0802,!6000-600b,!fa00
[✔] pbl --add-option cio_ignore=all,!0800-0802,!6000-600b,!fa00
kernel=/boot/vmlinuz
initrd=/boot/initrd
append="mitigations=0 quiet=99 foo=\"bar  zap\" nosimplefb=1 foobar1= foobar2 cio_ignore=all,!0800-0802,!6000-600b,!fa00"
[✔] pbl --default-settings
