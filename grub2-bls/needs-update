#! /usr/bin/sh

# Settings from /etc/sysconfig/filename are available as environment vars
# with the name 'SYS__FILENAME__KEY' (filename converted to upper case).
#
# Not all files are parsed, current list is:
#   bootloader, language
#

# usage: needs-update
#
# Report whether the boot loader deployed in the ESP is the one the system
# has.
#
# One of "update", "current" or "newer" is written into the file passed via
# the 'PBL_RESULT' environment var. Nothing is written when the question
# cannot be answered.

# include common functions
. "$PBL_INCLUDE/library"

# print the GRUB2 version embedded in the EFI binary $1
#
# The version is a string of its own, the one that fills in the format the
# banner is printed with, so it is the run that follows the marker. GRUB2
# only reports a major.minor that does not change between builds, so the
# modification time is appended to it, as in lib_shim_version.
#
loader_version ()
{
  # one printable run per line, the runs collapsed so that the version is
  # the line that follows the marker
  grub_version=$(tr -cs '[:print:]' '\n' < "$1" |
    sed -n '/^GNU GRUB  version %s$/{n;p;q;}')

  [ -n "$grub_version" ] || return 0

  echo "$grub_version-$(date -r "$1" +%Y%m%d%H%M)"
}

lib_get_efi_mount_dir
lib_get_efi_distro_dir

efi_dir="$efi_mount_dir/EFI/$efi_distro_dir"

# behind shim the loader is deployed under the name shim starts
deployed=$(lib_first_existing "$efi_dir/grub.efi" "$efi_dir/grubbls.efi")

# the platform directory is named after the architecture, in the spellings
# of GRUB2
grub_arch=$(uname -m)

case "$grub_arch" in
  i?86) grub_arch=i386 ;;
  aarch64*) grub_arch=arm64 ;;
  arm*) grub_arch=arm ;;
esac

# the BLS build, and not the grub.efi of the package: that one still has the
# BLS patches, but it expects a configuration file that nothing writes
available="/usr/share/grub2/$grub_arch-efi/grubbls.efi"

if [ -z "$deployed" ] || [ ! -e "$available" ] ; then
  echo "no grub2-bls to compare"
  exit 0
fi

deployed_version=$(loader_version "$deployed")
available_version=$(loader_version "$available")

if [ -z "$deployed_version" ] || [ -z "$available_version" ] ; then
  echo "no grub2-bls version in $deployed or $available"
  exit 0
fi

result=$(lib_update_status "$efi_dir" "$deployed_version" "$available_version")

if [ -n "$result" ] ; then
  echo "$result" >> "$PBL_RESULT"
fi

exit 0
