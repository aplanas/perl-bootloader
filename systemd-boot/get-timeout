#! /usr/bin/sh

# Settings from /etc/sysconfig/filename are available as environment vars
# with the name 'SYS__FILENAME__KEY' (filename converted to upper case).
#
# Not all files are parsed, current list is:
#   bootloader, language
#

# usage: get-timeout
#
# Read the boot menu timeout, in seconds.
#
# The timeout is written into the file passed via 'PBL_RESULT' environment var.
# Nothing is returned if no timeout is set.

# include common functions
. "$PBL_INCLUDE/library"

lib_get_efi_mount_dir

# the EFI variable wins, loader.conf is what is left on a system booted
# without one
timeout=$(lib_efi_var_get LoaderConfigTimeout)

if [ -z "$timeout" ] ; then
  timeout=$(lib_loader_conf_get "$efi_mount_dir/loader/loader.conf" timeout)
fi

timeout=$(lib_normalize_timeout "$timeout")

if [ -n "$timeout" ] ; then
  echo "$timeout" >> "$PBL_RESULT"
fi

exit 0
